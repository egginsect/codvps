[Unit]
Description=OpenCode headless server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/local/bin/codvps internal shell-exec --provider opencode -- %h/.opencode/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=always
RestartSec=5
Environment="PATH=%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=%h/.config/codvps/opencode-env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=no

[Install]
WantedBy=default.target
